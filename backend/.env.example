
# Nginx 反向代理配置
NGINX_DATA_PATH=/home/ubuntu
FRONTEND_PAGE=/home/ubuntu

# Elasticsearch 检索服务配置
ELASTIC_USERNAME=elastic
ELASTIC_PASSWORD=replace_with_a_strong_elasticsearch_password
ES_PORT=1200
STACK_VERSION=8.11.3
MEM_LIMIT=8073741824
TIMEZONE='Asia/Shanghai'

DASHSCOPE_API_KEY=""
DASHSCOPE_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
CHAT_MODEL=deepseek-v4-pro
# 入库时可选用图像模型解析图表和归属不明确的表格，文本聊天模型单独配置。
FIGURE_VISION_ENABLED=false
FIGURE_VISION_MODEL=
# 凭据或地址为空时，继承 DASHSCOPE_API_KEY / DASHSCOPE_BASE_URL。
FIGURE_VISION_API_KEY=
FIGURE_VISION_BASE_URL=
# 需求理解和首轮规划共用一次调用；后续仅按证据缺口重规划。
AGENT_MODEL=deepseek-v4-pro
AGENT_MAX_STEPS=3
# 历史指代消解模型；未配置时继承 AGENT_MODEL。
AGENT_CONTEXT_MODEL=deepseek-v4-pro
# 检索层只做固定词表的等价别名扩展，不调用改写或扩展模型。
RETRIEVAL_ALIAS_EXPANSION_ENABLED=true
# 每次请求的规划与知识库检索共用预算；回答流使用单独的执行阶段。
RAG_QUERY_DEADLINE_SECONDS=45
RAG_QUERY_MAX_MODEL_CALLS=16
RAG_QUERY_MAX_RETRIEVALS=12
# 每次请求限制同一轮并发数；进程共用线程池和有界队列。
RAG_QUERY_CONCURRENCY=3
RAG_QUERY_WORKERS=8
RAG_BRIDGE_EXTRACTION_MODEL=qwen3.7-flash-2026-07-15
RAG_BRIDGE_EXTRACTION_TIMEOUT_SECONDS=6
RAG_EVIDENCE_SUFFICIENCY_ENABLED=true
RAG_EVIDENCE_SUFFICIENCY_MODEL=qwen3.7-flash-2026-07-15
RAG_EVIDENCE_SUFFICIENCY_TIMEOUT_SECONDS=8
RAG_EVIDENCE_SUFFICIENCY_TRANSIENT_RETRY=true
RAG_EVIDENCE_SUFFICIENCY_FAIL_OPEN=false

# hybrid：规则不能确认时，按固定要求抽取候选并独立核验关系；rules 仅使用规则。
# 旧 RAG_FINANCIAL_FACT_MODEL_ENABLED 仍兼容；新模式显式配置时优先。
RAG_FINANCIAL_VERIFICATION_MODE=hybrid
RAG_FINANCIAL_FACT_MODEL=qwen3.7-flash-2026-07-15
RAG_FINANCIAL_FACT_TIMEOUT_SECONDS=8
RAG_FINANCIAL_FACT_MAX_CHUNKS=3
RAG_FINANCIAL_FACT_MAX_CANDIDATES=12
# 表格行命中完成排序后再扩展父表上下文，随后进行充分性检查和回答。
RAG_TABLE_CONTEXT_EXPANSION_ENABLED=true
RAG_TABLE_SMALL_TABLE_ROWS=5
RAG_TABLE_NEIGHBOR_RADIUS=2
RAG_TABLE_CONTEXT_MAX_TOKENS=512
RAG_TABLE_CONTEXT_MAX_COLUMNS=8
# 离线端到端回答与引用评判配置，不影响在线聊天。
E2E_JUDGE_MODEL=qwen3.7-flash-2026-07-15
CHAT_HISTORY_MAX_TURNS=8
CHAT_HISTORY_MAX_CHARS=12000
WEB_SEARCH_MODEL=qwen-plus
DASHSCOPE_NATIVE_BASE_URL="https://dashscope.aliyuncs.com/api/v1"

# BGE Embedding：local 在 API 容器内跑，remote 调用独立 CPU/GPU 服务
EMBEDDING_BACKEND=local
EMBEDDING_MODEL_ID=BAAI/bge-small-zh-v1.5
BGE_MODEL_HOST_PATH=../../models/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
EMBEDDING_REMOTE_BASE_URL=
EMBEDDING_REMOTE_PATH=/v1/embeddings
EMBEDDING_REMOTE_API_KEY=
EMBEDDING_REMOTE_TIMEOUT_SECONDS=30
EMBEDDING_REMOTE_MAX_RETRIES=2

# BGE Reranker：可与 Embedding 独立选择 local/remote
RERANKER_BACKEND=local
RERANKER_MODEL_ID=BAAI/bge-reranker-v2-m3
RERANKER_MODEL_HOST_PATH=../../models/bge-reranker-v2-m3
RERANKER_DEVICE=cpu
RERANKER_BATCH_SIZE=8
RERANKER_MAX_LENGTH=1024
# AgentRAG 内部的阈值按 0～1 概率解释；本地或远程 raw logits 会先转成概率。
RERANKER_SCORE_MODE=probability
RERANKER_REMOTE_BASE_URL=
RERANKER_REMOTE_PATH=/v1/rerank
RERANKER_REMOTE_API_KEY=
RERANKER_REMOTE_TIMEOUT_SECONDS=30
RERANKER_REMOTE_MAX_RETRIES=2
# 远程服务实际返回 raw_logits 还是 0～1 probability
RERANKER_REMOTE_SCORE_MODE=raw_logits

# PostgreSQL 数据库配置
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_a_strong_postgres_password
POSTGRES_DB=gsk
DATABASE_URL=postgresql://postgres:replace_with_a_strong_postgres_password@localhost:5432/gsk

# 应用鉴权
JWT_SECRET_KEY=replace_with_a_long_random_string

# RAGFlow（仅在调用 RAGFlow 示例脚本时需要）
RAGFLOW_BASE_URL=localhost:9380
RAGFLOW_API_KEY=""


ES_HOST=http://localhost:1200
# Elasticsearch 地址示例：ES_HOST=http://es01:9200
