
# nginx 
NGINX_DATA_PATH=/home/ubuntu
FRONTEND_PAGE=/home/ubuntu

# es
ELASTIC_USERNAME=elastic
ELASTIC_PASSWORD=replace_with_a_strong_elasticsearch_password
ES_PORT=1200
STACK_VERSION=8.11.3
MEM_LIMIT=8073741824
TIMEZONE='Asia/Shanghai'

DASHSCOPE_API_KEY=""
DASHSCOPE_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
CHAT_MODEL=deepseek-v4-pro
AGENT_MODEL=deepseek-v4-pro
CHAT_HISTORY_MAX_TURNS=8
CHAT_HISTORY_MAX_CHARS=12000
WEB_SEARCH_MODEL=qwen-plus
DASHSCOPE_NATIVE_BASE_URL="https://dashscope.aliyuncs.com/api/v1"

# 本地 BGE Embedding（路径相对 backend/docker-compose.yml）
BGE_MODEL_HOST_PATH=../../models/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_a_strong_postgres_password
POSTGRES_DB=gsk
DATABASE_URL=postgresql://postgres:replace_with_a_strong_postgres_password@localhost:5432/gsk

# 应用鉴权
JWT_SECRET_KEY=replace_with_a_long_random_string

# RAGFlow（仅在调用 RAGFlow 示例脚本时需要）
RAGFLOW_BASE_URL=localhost:9380
RAGFLOW_API_KEY=""


ES_HOST=http://localhost:1200
# ES_HOST=http://es01:9200
