INFERENCE_PORT=9000
INFERENCE_SERVER_API_KEY=replace_with_a_long_random_key

# GPU 主机上的模型目录
EMBEDDING_MODEL_HOST_PATH=/data/models/bge-small-zh-v1.5
RERANKER_MODEL_HOST_PATH=/data/models/bge-reranker-v2-m3
# 不使用 Docker 时，服务直接读取下面两个路径。
EMBEDDING_MODEL_PATH=/data/models/bge-small-zh-v1.5
RERANKER_MODEL_PATH=/data/models/bge-reranker-v2-m3

EMBEDDING_MODEL_ID=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cuda
EMBEDDING_BATCH_SIZE=32

RERANKER_MODEL_ID=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cuda
RERANKER_BATCH_SIZE=8
RERANKER_MAX_LENGTH=1024
INFERENCE_SERVER_RERANKER_SCORE_MODE=raw_logits

# 启动时加载两个模型，配置或显存不足会立即暴露
PRELOAD_MODELS=true
INFERENCE_MAX_CONCURRENCY=1
INFERENCE_MAX_REQUEST_ITEMS=128
CUDA_VISIBLE_DEVICES=0
